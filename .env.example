# =============================================================================
# Gestión Comercial – variables de entorno (nube / local)
# =============================================================================
# Copiá a .env (backend) o configurá en Render / Neon. Nunca subas secretos a Git.
# =============================================================================

# --- App ---
APP_NAME=Gestión Comercial
APP_VERSION=0.1.0
DEBUG=false

# Generar: openssl rand -hex 32
SECRET_KEY=CAMBIAR_openssl_rand_hex_32

# Neon (u otro Postgres). OBLIGATORIO el dialecto +asyncpg para la API.
# Ejemplo Neon:
#   postgresql+asyncpg://USER:PASS@ep-xxxx.region.aws.neon.tech/neondb?ssl=require
DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST/DB?ssl=require

# Orígenes del frontend (JSON array). Ejemplo Render:
#   ["https://gestion-web-xxxx.onrender.com"]
CORS_ORIGINS=["http://localhost:3000"]

CREATE_DEMO_DATA=false
AUTO_CREATE_SCHEMA=false

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Solo frontend (build-time en Vercel/Render) ---
# NEXT_PUBLIC_API_URL=https://gestion-api-xxxx.onrender.com/api/v1
